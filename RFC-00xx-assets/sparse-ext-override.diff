-// addmm(dense, sparse COO, dense) for SparseCUDA: a port of
-// s_addmm_out_sparse_dense_cuda, s_addmm_out_csr_sparse_dense_cuda_worker and
-// sparse::cuda::csrmm2 (aten/src/ATen/native/sparse/cuda/). Stable ABI for every
-// torch call; cuSPARSE is called directly. The stable ABI exposes no cuSPARSE
-// handle (it has torch_get_current_cuda_blas_handle only), so the package keeps
-// its own handle per device and binds it to torch's current stream.
-#include "addmm.h"
-
-#include <torch/csrc/stable/accelerator.h>
-#include <torch/headeronly/util/complex.h>
-
-#include <cuda_runtime_api.h>
-#include <cusparse.h>
-
-#include <array>
-#include <climits>
-
-#define SX_CUSPARSE_CHECK(expr)                                                \
-  do {                                                                         \
-    cusparseStatus_t st_ = (expr);                                             \
-    STD_TORCH_CHECK(st_ == CUSPARSE_STATUS_SUCCESS, "cuSPARSE error: ",        \
-                    cusparseGetErrorString(st_), " at " #expr);                \
-  } while (0)
-
-namespace sx {
-namespace {
-
-constexpr int kMaxDevices = 64;
-
-cusparseHandle_t current_handle(int32_t device) {
-  STD_TORCH_CHECK(device >= 0 && device < kMaxDevices, "sparse-ext: bad CUDA device index");
-  thread_local std::array<cusparseHandle_t, kMaxDevices> handles{};
-  if (!handles[device]) {
-    SX_CUSPARSE_CHECK(cusparseCreate(&handles[device]));
-  }
-  auto stream = torch::stable::accelerator::getCurrentStream(device);
-  SX_CUSPARSE_CHECK(cusparseSetStream(handles[device], static_cast<cudaStream_t>(stream.nativeHandle())));
-  return handles[device];
-}
-
-cusparseSpMMAlg_t default_alg(int32_t device) {
-  // As in-tree: ALG1 is broken on SM89 as of CUDA 11.8+.
-  cudaDeviceProp prop;
-  STD_TORCH_CHECK(cudaGetDeviceProperties(&prop, device) == cudaSuccess, "cudaGetDeviceProperties failed");
-  return prop.major == 8 && prop.minor == 9 ? CUSPARSE_SPMM_CSR_ALG2 : CUSPARSE_SPMM_CSR_ALG1;
-}
-
-template <typename T> struct CudaType;
-template <> struct CudaType<float> { using type = float; static constexpr cudaDataType id = CUDA_R_32F; };
-template <> struct CudaType<double> { using type = double; static constexpr cudaDataType id = CUDA_R_64F; };
-template <> struct CudaType<c10::complex<float>> { using type = cuComplex; static constexpr cudaDataType id = CUDA_C_32F; };
-template <> struct CudaType<c10::complex<double>> { using type = cuDoubleComplex; static constexpr cudaDataType id = CUDA_C_64F; };
-
-template <typename T>
-T cast(cdouble v) {
-  if constexpr (std::is_floating_point_v<T>) {
-    return static_cast<T>(v.real());
-  } else {
-    return T(v.real(), v.imag());
-  }
-}
-
-bool same_tensor(const Tensor& a, const Tensor& b) {
-  return a.data_ptr() == b.data_ptr() && vec(a.sizes()) == vec(b.sizes()) &&
-         vec(a.strides()) == vec(b.strides());
-}
-
-// Port of csrmm2('n', transb, ...): C = alpha * A @ op(B) + beta * C, column-major.
-template <typename T>
-void csrmm2(cusparseHandle_t handle, int32_t device, char transb, int64_t m, int64_t n, int64_t k,
-            int64_t nnz, T alpha, const T* csrval, const int* crow, const int* col, const T* b,
-            int64_t ldb, T beta, T* c, int64_t ldc, const Tensor& like) {
-  if (csrval == nullptr || b == nullptr || c == nullptr) return;
-  STD_TORCH_CHECK(m <= INT_MAX && n <= INT_MAX && k <= INT_MAX && nnz <= INT_MAX && ldb <= INT_MAX && ldc <= INT_MAX,
-                  "At the moment, cusparseSpMM only supports m, n, k, nnz, ldb, ldc with the bound [val] <= INT_MAX");
-  using CT = typename CudaType<T>::type;
-  constexpr cudaDataType vt = CudaType<T>::id;
-  const auto opa = CUSPARSE_OPERATION_NON_TRANSPOSE;
-  const auto opb = transb == 'n' ? CUSPARSE_OPERATION_NON_TRANSPOSE : CUSPARSE_OPERATION_TRANSPOSE;
-
-  cusparseSpMatDescr_t descA;
-  SX_CUSPARSE_CHECK(cusparseCreateCsr(&descA, m, k, nnz, const_cast<int*>(crow), const_cast<int*>(col),
-                                      const_cast<T*>(csrval), CUSPARSE_INDEX_32I, CUSPARSE_INDEX_32I,
-                                      CUSPARSE_INDEX_BASE_ZERO, vt));
-  int64_t kb = k, nb = n;
-  if (transb != 'n') std::swap(kb, nb);
-  cusparseDnMatDescr_t descB, descC;
-  SX_CUSPARSE_CHECK(cusparseCreateDnMat(&descB, kb, nb, ldb, const_cast<T*>(b), vt, CUSPARSE_ORDER_COL));
-  SX_CUSPARSE_CHECK(cusparseCreateDnMat(&descC, m, n, ldc, c, vt, CUSPARSE_ORDER_COL));
-
-  const auto alg = default_alg(device);
-  size_t buffer_size = 0;
-  SX_CUSPARSE_CHECK(cusparseSpMM_bufferSize(handle, opa, opb, reinterpret_cast<CT*>(&alpha), descA, descB,
-                                            reinterpret_cast<CT*>(&beta), descC, vt, alg, &buffer_size));
-  // The workspace comes from torch's caching allocator, through torch::stable::empty.
-  Tensor buffer = torch::stable::empty({static_cast<int64_t>(buffer_size)}, ScalarType::Byte,
-                                       std::nullopt, like.device());
-  SX_CUSPARSE_CHECK(cusparseSpMM(handle, opa, opb, reinterpret_cast<CT*>(&alpha), descA, descB,
-                                 reinterpret_cast<CT*>(&beta), descC, vt, alg, buffer.mutable_data_ptr()));
-  SX_CUSPARSE_CHECK(cusparseDestroySpMat(descA));
-  SX_CUSPARSE_CHECK(cusparseDestroyDnMat(descB));
-  SX_CUSPARSE_CHECK(cusparseDestroyDnMat(descC));
-}
-
-template <typename T>
-void csr_worker(cusparseHandle_t handle, int32_t device, int64_t nnz, int64_t m, int64_t n, int64_t k,
-                Tensor& r_, cdouble beta, const Tensor& t, cdouble alpha, const Tensor& crow,
-                const Tensor& col, const Tensor& values, const Tensor& dense) {
-  const T cast_beta = cast<T>(beta), cast_alpha = cast<T>(alpha);
-  if (cast_beta == T(0)) {
-    zero_(r_);
-  } else if (!same_tensor(t, r_)) {
-    copy_(r_, t);
-  }
-  Tensor r__ = r_;
-  if (!(r_.stride(0) == 1 && r_.stride(1) == r_.size(0))) {
-    // column-major copy of r_
-    // clone(Contiguous), not contiguous(): a (1, m) view with strides (1, 1) is
-    // already "contiguous" and would keep ldc = 1.
-    r__ = torch::stable::transpose(
-        call<Tensor>("aten::clone", "", torch::stable::transpose(r_, 0, 1),
-                     std::optional<torch::headeronly::MemoryFormat>(torch::headeronly::MemoryFormat::Contiguous)),
-        0, 1);
-  }
-  Tensor dense_ = dense;
-  char transpose_dense;
-  if (dense.stride(0) == 1 && dense.stride(1) == dense.size(0)) {
-    transpose_dense = 'n';
-  } else if (dense.stride(1) == 1 && dense.stride(0) == dense.size(1)) {
-    transpose_dense = 't';
-  } else {
-    transpose_dense = 't';
-    dense_ = torch::stable::contiguous(dense);
-  }
-  csrmm2<T>(handle, device, transpose_dense, m, n, k, nnz, cast_alpha, values.const_data_ptr<T>(),
-            crow.const_data_ptr<int32_t>(), col.const_data_ptr<int32_t>(), dense_.const_data_ptr<T>(),
-            transpose_dense == 'n' ? dense_.stride(1) : dense_.stride(0), cast_beta,
-            r__.mutable_data_ptr<T>(), r__.stride(1), r_);
-  if (!same_tensor(r__, r_)) {
-    copy_(r_, r__);
-  }
-}
-
-}  // namespace
-
-void addmm_out_sparse_dense_cuda(Tensor& r_, const Tensor& t, const Tensor& sparse_,
-                                 const Tensor& dense, cdouble beta, cdouble alpha) {
-  STD_TORCH_CHECK(t.is_cuda(), "Expected all tensors to be on the same device. addmm: expected 'self' to be CUDA, but got CPU");
-  STD_TORCH_CHECK(r_.is_cuda(), "Expected all tensors to be on the same device. addmm: expected 'out' to be CUDA, but got CPU");
-  STD_TORCH_CHECK(sparse_.is_cuda(), "Expected all tensors to be on the same device. addmm: expected 'mat1' to be CUDA, but got CPU");
-  STD_TORCH_CHECK(dense.is_cuda(), "Expected all tensors to be on the same device. addmm: expected 'mat2' to be CUDA, but got CPU");
-  const int32_t device = sparse_.get_device_index();
-  STD_TORCH_CHECK(r_.get_device_index() == device && t.get_device_index() == device &&
-                  dense.get_device_index() == device, "addmm: expected all tensors on the same CUDA device");
-  STD_TORCH_CHECK(dense.dim() == 2, "addmm: 2D tensor expected, got ", dense.dim(), "D tensor");
-  STD_TORCH_CHECK(sparse_dim(sparse_) == 2,
-                  "addmm: expected first two dims to be sparse (indices has size 2 at first dim), but got ",
-                  sparse_dim(sparse_), " sparse dims");
-  const int64_t m = sparse_.size(0), k = sparse_.size(1), n = dense.size(1);
-  STD_TORCH_CHECK(t.size(0) == m, "addmm: Argument #1 (t): Expected dim 0 size ", m, ", got ", t.size(0));
-  STD_TORCH_CHECK(t.size(1) == n, "addmm: Argument #1 (t): Expected dim 1 size ", n, ", got ", t.size(1));
-  STD_TORCH_CHECK(dense.size(0) == k, "addmm: Argument #3 (dense): Expected dim 0 size ", k, ", got ", dense.size(0));
-
-  torch::stable::accelerator::DeviceGuard guard(device);
-  resize_(r_, {m, n});
-  const Tensor sparse = coalesce(sparse_);
-  const int64_t nz = nnz(sparse);
-  if (nz == 0) {
-    mul_out(t, scalar_tensor(beta, r_.scalar_type()), r_);
-    return;
-  }
-  const Tensor idx = indices(sparse);
-  const Tensor vals = sx::values(sparse);
-  // _to_csr_int: COO row indices -> CSR row offsets, with cusparseXcoo2csr.
-  const Tensor rows = to_dtype(torch::stable::select(idx, 0, 0), ScalarType::Int);
-  const Tensor col = to_dtype(torch::stable::select(idx, 0, 1), ScalarType::Int);
-  STD_TORCH_CHECK(m <= INT_MAX && nz <= INT_MAX,
-                  "cusparseXcoo2csr only supports m, nnz with the bound [val] <= INT_MAX");
-  Tensor crow = torch::stable::empty({m + 1}, ScalarType::Int, std::nullopt, sparse.device());
-  cusparseHandle_t handle = current_handle(device);
-  SX_CUSPARSE_CHECK(cusparseXcoo2csr(handle, rows.const_data_ptr<int32_t>(), static_cast<int>(nz),
-                                     static_cast<int>(m), crow.mutable_data_ptr<int32_t>(),
-                                     CUSPARSE_INDEX_BASE_ZERO));
-  switch (vals.scalar_type()) {
-    case ScalarType::Float:
-      csr_worker<float>(handle, device, nz, m, n, k, r_, beta, t, alpha, crow, col, vals, dense); break;
-    case ScalarType::Double:
-      csr_worker<double>(handle, device, nz, m, n, k, r_, beta, t, alpha, crow, col, vals, dense); break;
-    case ScalarType::ComplexFloat:
-      csr_worker<c10::complex<float>>(handle, device, nz, m, n, k, r_, beta, t, alpha, crow, col, vals, dense); break;
-    case ScalarType::ComplexDouble:
-      csr_worker<c10::complex<double>>(handle, device, nz, m, n, k, r_, beta, t, alpha, crow, col, vals, dense); break;
-    default:
-      STD_TORCH_CHECK(false, "\"addmm_sparse_cuda\" not implemented for this dtype");
-  }
-}
-

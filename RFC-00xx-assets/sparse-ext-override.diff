+++ /dev/null
@@ -1,37 +0,0 @@
-// addmm(dense, sparse COO, dense) kernels, written on the stable ABI. They are
-// registered by register_addmm.cpp, which is not on the stable ABI: addmm's
-// schema has `Scalar beta, Scalar alpha`, and the stable boxed kernel cannot
-// receive a Scalar (shim_common.cpp from_ivalue has no ScalarType::Scalar case).
-#pragma once
-
-// The stable C shim (AtenTensorHandle and friends); it lives under inductor/ for
-// historical reasons and is what torch/csrc/stable builds on.
-#include <torch/csrc/inductor/aoti_torch/c/shim.h>
-
-// The C entry point register_addmm.cpp calls. Takes ownership of every handle it
-// is given; `out` may be null (functional addmm: a new strided result). Returns a
-// new handle to the result. expand_self: broadcast self to (mat1.size(0),
-// mat2.size(1)), as addmm and addmm.out do and addmm_ does not.
-extern "C" AtenTensorHandle sx_addmm(
-    AtenTensorHandle self, AtenTensorHandle mat1, AtenTensorHandle mat2,
-    double beta_re, double beta_im, double alpha_re, double alpha_im,
-    AtenTensorHandle out, int expand_self);
-
-#ifdef __cplusplus
-#include "sx.h"
-#include <complex>
-namespace sx {
-using cdouble = std::complex<double>;
-// addmm / addmm.out / addmm_ on a sparse COO mat1, CPU or CUDA. out: the result
-// tensor (none: a new strided one); expand_self as for sx_addmm.
-Tensor addmm(const Tensor& self, const Tensor& mat1, const Tensor& mat2, cdouble beta,
-             cdouble alpha, std::optional<Tensor> out, bool expand_self);
-// A 0-dim CPU tensor of dtype holding v.
-Tensor scalar_tensor(cdouble v, ScalarType dtype);
-#ifdef SX_USE_CUDA
-// Port of s_addmm_out_sparse_dense_cuda (cuSPARSE SpMM), in addmm_cuda.cu.
-void addmm_out_sparse_dense_cuda(Tensor& r, const Tensor& t, const Tensor& sparse,
-                                 const Tensor& dense, cdouble beta, cdouble alpha);
-#endif
-}  // namespace sx
-#endif

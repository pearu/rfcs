 //   entry positions (in-tree: the internal mul_sparse_sparse_out_stub, which
 //   is not an operator), and coalesces both inputs first.
+//
+// These kernels override ATen's (registered over them, not instead of
+// them). SPARSETORCH_USE_ATEN=1 at load time skips the aten registrations, so
+// ATen's kernels serve. A per-device call counter (sparse_ext::mul_calls) shows
+// which kernel ran; sparse_ext::mul_out is the same kernel under the package's
+// own name, for callers (a Python registration) that must not reach aten::mul.out.
 #include "sx.h"
 
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+
 #include <torch/headeronly/util/BFloat16.h>
 #include <torch/headeronly/util/Half.h>
 #include <torch/headeronly/util/complex.h>
@@ -247,23 +257,69 @@ Tensor& mul_out_sparse(const Tensor& t_, const Tensor& src_, Tensor& r, bool cpu
   return mul_sparse_sparse_out(t_, src_, r);
 }
 
+// Calls of the package's mul kernels: [0] SparseCPU, [1] SparseCUDA.
+std::atomic<int64_t> mul_calls_[2];
+
 Tensor mul_out_sparse_cpu(Tensor self, Tensor other, Tensor out) {
+  mul_calls_[0]++;
   mul_out_sparse(self, other, out, /*cpu=*/true);
   return out;
 }
 
 Tensor mul_out_sparse_cuda(Tensor self, Tensor other, Tensor out) {
+  mul_calls_[1]++;
   mul_out_sparse(self, other, out, /*cpu=*/false);
   return out;
 }
 
+// device: 0 CPU, 1 CUDA. reset: set the counter to 0 after reading it.
+int64_t mul_calls(int64_t device, bool reset) {
+  STD_TORCH_CHECK(device == 0 || device == 1, "sparse_ext::mul_calls: device is 0 (CPU) or 1 (CUDA)");
+  return reset ? mul_calls_[device].exchange(0) : mul_calls_[device].load();

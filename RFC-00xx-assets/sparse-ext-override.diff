+  const char* v = std::getenv("SPARSETORCH_USE_ATEN");
+  return v && std::strcmp(v, "1") == 0;
+}
+
+// Read once, at load: the static initializers below (same file, later) use it.
+const bool use_aten_at_load = use_aten();
+
+// Whether this process loaded the package with SPARSETORCH_USE_ATEN=1.
+bool uses_aten() { return use_aten_at_load; }
+
 }  // namespace
 }  // namespace sx
 
+STABLE_TORCH_LIBRARY(sparse_ext, m) {
+  m.def("mul_calls(int device, bool reset=False) -> int");
+  m.def("uses_aten() -> bool");
+  m.def("mul_out(Tensor self, Tensor other, *, Tensor(a!) out) -> Tensor(a!)");
+}
+
+STABLE_TORCH_LIBRARY_IMPL(sparse_ext, CompositeExplicitAutograd, m) {
+  m.impl("mul_calls", TORCH_BOX(&sx::mul_calls));
+  m.impl("uses_aten", TORCH_BOX(&sx::uses_aten));
+}
+
+STABLE_TORCH_LIBRARY_IMPL(sparse_ext, SparseCPU, m) {
+  m.impl("mul_out", TORCH_BOX(&sx::mul_out_sparse_cpu));
+}
+
+STABLE_TORCH_LIBRARY_IMPL(sparse_ext, SparseCUDA, m) {
+  m.impl("mul_out", TORCH_BOX(&sx::mul_out_sparse_cuda));
+}
+
+// Over ATen's kernels: the dispatcher keeps both and serves the newest
+// (OperatorEntry::registerKernel), warning once per process.
 STABLE_TORCH_LIBRARY_IMPL(aten, SparseCPU, m) {
+  if (sx::use_aten_at_load) return;
   m.impl("mul.out", TORCH_BOX(&sx::mul_out_sparse_cpu));
 }
 
 STABLE_TORCH_LIBRARY_IMPL(aten, SparseCUDA, m) {
+  if (sx::use_aten_at_load) return;
   m.impl("mul.out", TORCH_BOX(&sx::mul_out_sparse_cuda));
 }

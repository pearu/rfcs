deleted file mode 100644
index 9744da4..0000000
--- a/sparse-ext/csrc/addmm.cpp
+++ /dev/null
@@ -1,169 +0,0 @@
-// addmm(dense, sparse COO, dense) for SparseCPU (and the dispatch to the CUDA
-// kernel), on the stable ABI only. A port of s_addmm_out_sparse_dense_cpu and its
-// worker (aten/src/ATen/native/sparse/SparseTensorMath.cpp). The in-tree worker
-// calls at::native::cpublas::axpy for each nonzero; the stable ABI has no BLAS,
-// so the axpy is a plain loop here.
-#include "addmm.h"
-
-#include <torch/headeronly/util/BFloat16.h>
-#include <torch/headeronly/util/Half.h>
-#include <torch/headeronly/util/complex.h>
-
-#define SX_FORALL_ADDMM_TYPES(_)                                   \
-  _(uint8_t, Byte) _(int8_t, Char) _(int16_t, Short) _(int, Int)   \
-  _(int64_t, Long) _(float, Float) _(double, Double)               \
-  _(c10::Half, Half) _(c10::BFloat16, BFloat16)                    \
-  _(c10::complex<float>, ComplexFloat) _(c10::complex<double>, ComplexDouble)
-
-namespace sx {
-namespace {
-
-template <typename T> struct is_cplx : std::false_type {};
-template <typename T> struct is_cplx<c10::complex<T>> : std::true_type {};
-
-template <typename T>
-T cast(cdouble v) {
-  if constexpr (is_cplx<T>::value) {
-    return T(v.real(), v.imag());
-  } else {
-    return static_cast<T>(v.real());
-  }
-}
-
-bool same_tensor(const Tensor& a, const Tensor& b) {
-  return a.data_ptr() == b.data_ptr() && vec(a.sizes()) == vec(b.sizes()) &&
-         vec(a.strides()) == vec(b.strides());
-}
-
-template <typename T>
-void addmm_cpu_worker(int64_t nnz, int64_t dim_i, int64_t dim_j, int64_t dim_k, Tensor& r,
-                      cdouble beta, const Tensor& t, cdouble alpha, const Tensor& indices,
-                      const Tensor& values, const Tensor& dense) {
-  const T cast_alpha = cast<T>(alpha);
-  const T cast_beta = cast<T>(beta);
-  T* r_ptr = r.mutable_data_ptr<T>();
-  const int64_t r_stride0 = r.stride(0), r_stride1 = r.stride(1);
-
-  if (cast_beta == T(0)) {
-    zero_(r);
-  } else if (cast_beta == T(1)) {
-    if (!same_tensor(r, t)) copy_(r, t);
-  } else {
-    const T* t_ptr = t.const_data_ptr<T>();
-    const int64_t t_stride0 = t.stride(0), t_stride1 = t.stride(1);
-    for (int64_t i = 0; i < dim_i; i++)
-      for (int64_t k = 0; k < dim_k; k++)
-        r_ptr[i * r_stride0 + k * r_stride1] = cast_beta * t_ptr[i * t_stride0 + k * t_stride1];
-  }
-
-  const int64_t* idx = indices.const_data_ptr<int64_t>();
-  const int64_t is0 = indices.stride(0), is1 = indices.stride(1);
-  const T* val = values.const_data_ptr<T>();
-  const int64_t vs = values.stride(0);
-  const T* dense_ptr = dense.const_data_ptr<T>();
-  const int64_t dense_stride0 = dense.stride(0), dense_stride1 = dense.stride(1);
-  for (int64_t i = 0; i < nnz; i++) {
-    const int64_t row = idx[i * is1], col = idx[is0 + i * is1];
-    STD_TORCH_CHECK(col >= 0 && col < dim_j,
-                    "addmm: index out of column bound: ", col, " not between 1 and ", dim_j);
-    STD_TORCH_CHECK(row >= 0 && row < dim_i,
-                    "addmm: index out of row bound: ", row, " not between 1 and ", dim_i);
-    const T a = cast_alpha * val[i * vs];
-    const T* x = dense_ptr + col * dense_stride0;
-    T* y = r_ptr + row * r_stride0;
-    for (int64_t k = 0; k < dim_k; k++) y[k * r_stride1] += a * x[k * dense_stride1];
-  }
-}
-
-void addmm_out_sparse_dense_cpu(Tensor& r, const Tensor& t, const Tensor& sparse,
-                                const Tensor& dense, cdouble beta, cdouble alpha) {
-  STD_TORCH_CHECK(t.is_cpu(), "Expected all tensors to be on the same device. addmm expected 't' to be CPU tensor");
-  STD_TORCH_CHECK(r.is_cpu(), "Expected all tensors to be on the same device. addmm: expected 'out' to be CPU tensor");
-  STD_TORCH_CHECK(sparse.is_cpu(), "Expected all tensors to be on the same device. addmm: expected 'mat1' to be a CPU tensor");
-  STD_TORCH_CHECK(dense.is_cpu(), "Expected all tensors to be on the same device. addmm: expected 'mat2' to be a CPU tensor");
-  STD_TORCH_CHECK(r.layout() == Layout::Strided, "addmm_sparse_dense: expected strided result tensor");
-  STD_TORCH_CHECK(t.layout() == Layout::Strided, "addmm_sparse_dense: expected 't' to have strided layout");
-  STD_TORCH_CHECK(is_sparse(sparse) && dense.layout() == Layout::Strided,
-                  "addmm_sparse_dense: expected either 'mat1' to have sparse layout and 'mat2' to have strided layout");
-  STD_TORCH_CHECK(sparse_dim(sparse) == 2, "addmm: matrices expected, got ", sparse_dim(sparse), "D tensor");
-  STD_TORCH_CHECK(dense_dim(sparse) == 0, "addmm: scalar values expected, got ", dense_dim(sparse), "D values");
-  STD_TORCH_CHECK(dense.dim() == 2, "addmm: matrices expected, got ", dense.dim(), "D tensor");
-
-  const int64_t dim_i = sparse.size(0), dim_j = sparse.size(1), dim_k = dense.size(1);
-  STD_TORCH_CHECK(dense.size(0) == dim_j, "addmm: Argument #3 (dense): Expected dim 0 size ", dim_j, ", got ", dense.size(0));
-  STD_TORCH_CHECK(t.size(0) == dim_i, "addmm: Argument #1 (t): Expected dim 0 size ", dim_i, ", got ", t.size(0));
-  STD_TORCH_CHECK(t.size(1) == dim_k, "addmm: Argument #1 (t): Expected dim 1 size ", dim_k, ", got ", t.size(1));
-
-  resize_(r, {dim_i, dim_k});
-  const int64_t n = nnz(sparse);
-  if (n == 0) {
-    mul_out(t, scalar_tensor(beta, r.scalar_type()), r);
-    return;
-  }
-  const Tensor idx = indices(sparse);
-  const Tensor val = values(sparse);
-  switch (val.scalar_type()) {
-#define SX_CASE(T, N)                                                                    \
-    case ScalarType::N:                                                                  \
-      addmm_cpu_worker<T>(n, dim_i, dim_j, dim_k, r, beta, t, alpha, idx, val, dense);  \
-      break;
-    SX_FORALL_ADDMM_TYPES(SX_CASE)
-#undef SX_CASE
-    default:
-      STD_TORCH_CHECK(false, "\"addmm_sparse_dense\" not implemented for this dtype");
-  }
-}
-
-}  // namespace
-
-Tensor scalar_tensor(cdouble v, ScalarType dtype) {
-  Tensor s = torch::stable::empty({}, dtype);
-  switch (dtype) {
-#define SX_CASE(T, N) \
-    case ScalarType::N: *s.mutable_data_ptr<T>() = cast<T>(v); break;
-    SX_FORALL_ADDMM_TYPES(SX_CASE)
-#undef SX_CASE
-    case ScalarType::Bool: *s.mutable_data_ptr<bool>() = v != cdouble(0); break;
-    default: STD_TORCH_CHECK(false, "sparse-ext: unsupported dtype for a scalar");
-  }
-  return s;
-}
-
-}  // namespace sx
-
-namespace sx {
-
-Tensor addmm(const Tensor& self, const Tensor& mat1, const Tensor& mat2, cdouble beta,
-             cdouble alpha, std::optional<Tensor> out_, bool expand_self) {
-  Tensor out = out_ ? *out_
-                    : torch::stable::empty({0}, self.scalar_type(), std::nullopt, self.device());
-  const Tensor t = expand_self ? expand(self, {mat1.size(0), mat2.size(1)}) : self;
-  if (mat1.is_cuda()) {
-#ifdef SX_USE_CUDA
-    addmm_out_sparse_dense_cuda(out, t, mat1, mat2, beta, alpha);
-#else
-    STD_TORCH_CHECK(false, "sparse-ext was built without CUDA");
-#endif
-  } else {
-    addmm_out_sparse_dense_cpu(out, t, mat1, mat2, beta, alpha);
-  }
-  return out;
-}
-
-}  // namespace sx
-
-extern "C" AtenTensorHandle sx_addmm(
-    AtenTensorHandle self_h, AtenTensorHandle mat1_h, AtenTensorHandle mat2_h,
-    double beta_re, double beta_im, double alpha_re, double alpha_im,
-    AtenTensorHandle out_h, int expand_self) {
-  using namespace sx;
-  const Tensor self(self_h), mat1(mat1_h), mat2(mat2_h);
-  std::optional<Tensor> out;
-  if (out_h) out = Tensor(out_h);
-  const Tensor r = addmm(self, mat1, mat2, cdouble(beta_re, beta_im), cdouble(alpha_re, alpha_im),
-                         out, expand_self);
-  // A new handle for the caller; `r` releases its own.
-  AtenTensorHandle ret = nullptr;
-  STABLE_TORCH_ERROR_CODE_CHECK(aoti_torch_new_tensor_handle(r.get(), &ret));
-  return ret;
-}

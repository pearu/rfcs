+# Ops whose CPU/CUDA kernels moved to the sparsetorch package; ATen
+# keeps a stub. Their device shims keep their names and signatures (the headers do not
+# change), but their bodies call the dispatcher instead of ATen's kernel, so that a
+# compiled model reaches the package's kernel. Keys are OperatorName strings.
+OPS_MOVED_TO_PACKAGE = {"_to_sparse"}
+
+
+def moved_to_package(func: NativeFunction, dispatch_key: DispatchKey | None) -> bool:
+    return dispatch_key is not None and str(func.func.name) in OPS_MOVED_TO_PACKAGE

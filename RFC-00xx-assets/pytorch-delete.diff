diff --git a/aten/src/ATen/native/sparse/SparseMovedToPackage.cpp b/aten/src/ATen/native/sparse/SparseMovedToPackage.cpp
new file mode 100644
index 00000000000..9bd5b9a51bb
--- /dev/null
+++ b/aten/src/ATen/native/sparse/SparseMovedToPackage.cpp
@@ -0,0 +1,56 @@
+// Experiment: sparse kernels deleted from ATen are provided by the
+// sparsetorch package. Without it, a call on a sparse tensor raises one message:
+// - ops with no kernel for the key reach the backend fallback below;
+// - ops that also have a CompositeExplicitAutograd kernel (abs) would run that
+//   kernel on the sparse tensor instead, so their sparse lines point to a stub.
+#define TORCH_ASSERT_ONLY_METHOD_OPERATORS
+#include <ATen/core/Tensor.h>
+#include <ATen/core/dispatch/Dispatcher.h>
+#include <torch/library.h>
+
+#ifndef AT_PER_OPERATOR_HEADERS
+#include <ATen/NativeFunctions.h>
+#else
+#include <ATen/ops/abs_native.h>
+#endif
+
+namespace at::native {
+
+namespace {
+
+[[noreturn]] void sparse_kernels_moved(const std::string& op) {
+  TORCH_CHECK_NOT_IMPLEMENTED(
+      false, op, ": sparse kernels are provided by the sparsetorch package; install it");
+}
+
+void sparse_moved_fallback(const c10::OperatorHandle& op, torch::jit::Stack* /*stack*/) {
+  sparse_kernels_moved(c10::toString(op.operator_name()));
+}
+
+} // namespace
+
+Tensor abs_sparse_moved(const Tensor& /*self*/) {
+  sparse_kernels_moved("aten::abs");
+}
+
+Tensor& abs_sparse_moved_(Tensor& /*self*/) {
+  sparse_kernels_moved("aten::abs_");
+}
+
+Tensor& abs_sparse_moved_out(const Tensor& /*self*/, Tensor& /*out*/) {
+  sparse_kernels_moved("aten::abs.out");
+}
+
+#define SPARSE_MOVED_FALLBACK(KEY)                                                   \
+  TORCH_LIBRARY_IMPL(_, KEY, m) {                                                    \
+    m.fallback(torch::CppFunction::makeFromBoxedFunction<&sparse_moved_fallback>()); \
+  }
+
+SPARSE_MOVED_FALLBACK(SparseCPU)
+SPARSE_MOVED_FALLBACK(SparseCUDA)
+SPARSE_MOVED_FALLBACK(SparseCsrCPU)
+SPARSE_MOVED_FALLBACK(SparseCsrCUDA)
+SPARSE_MOVED_FALLBACK(SparseMeta)
+SPARSE_MOVED_FALLBACK(SparseCsrMeta)
+
+} // namespace at::native

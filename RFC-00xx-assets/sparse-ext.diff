index 0000000..c8c5b4a
--- /dev/null
+++ b/sparse-ext/torch_sparse_ext/__init__.py
@@ -0,0 +1,50 @@
+"""COO mul / addmm kernels for aten's SparseCPU and SparseCUDA keys, from outside
+the pytorch tree. Loaded by ``import torch`` through the ``torch.backends`` entry
+point; with TORCH_DEVICE_BACKEND_AUTOLOAD=0, ``import torch_sparse_ext`` loads it.
+
+aten::addmm, addmm_ and addmm.out take Scalars, which a stable-ABI kernel cannot
+receive. Two routes register them:
+- TORCH_SPARSE_EXT_ADDMM=cpp (default): the C++ bridge, module _bridge (not on the
+  stable ABI: tied to the torch it was built against);
+- TORCH_SPARSE_EXT_ADDMM=python: Python kernels (torch.library) that split each
+  Scalar into two floats and call the stable ops sparse_ext::addmm{,_out} in _C.
+  Only stable-ABI code is loaded.
+"""
+import os
+from pathlib import Path
+
+import torch
+
+_dir = Path(__file__).parent
+torch.ops.load_library(str(next(_dir.glob("_C*.so"))))
+
+ADDMM_ROUTE = os.environ.get("TORCH_SPARSE_EXT_ADDMM", "cpp")
+if ADDMM_ROUTE == "cpp":
+    torch.ops.load_library(str(next(_dir.glob("_bridge*.so"))))
+elif ADDMM_ROUTE == "python":
+    def _split(x):
+        c = complex(x)
+        return c.real, c.imag
+
+    def _addmm(self, mat1, mat2, *, beta=1, alpha=1):
+        return torch.ops.sparse_ext.addmm(self, mat1, mat2, *_split(beta), *_split(alpha))
+
+    def _addmm_out(self, mat1, mat2, *, beta=1, alpha=1, out):
+        return torch.ops.sparse_ext.addmm_out(self, mat1, mat2, *_split(beta), *_split(alpha), True, out)
+
+    def _addmm_(self, mat1, mat2, *, beta=1, alpha=1):
+        torch.ops.sparse_ext.addmm_out(self, mat1, mat2, *_split(beta), *_split(alpha), False, self)
+        return self
+
+    _lib = torch.library.Library("aten", "IMPL")
+    for _key in ("SparseCPU", "SparseCUDA"):
+        _lib.impl("addmm", _addmm, _key)
+        _lib.impl("addmm.out", _addmm_out, _key)
+        _lib.impl("addmm_", _addmm_, _key)
+else:
+    raise ValueError(f"TORCH_SPARSE_EXT_ADDMM={ADDMM_ROUTE!r}: expected 'cpp' or 'python'")
+
+
+def _autoload():
+    # Importing this module registered the kernels.
+    pass
